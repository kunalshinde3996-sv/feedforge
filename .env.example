# ---- LLM ----
# Which provider to use: anthropic | openai | gemini
LLM_PROVIDER=anthropic
# Exact model id for the chosen provider (required, no default on purpose)
LLM_MODEL=
# Only the key for the chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Server ----
PORT=8080
# Where job JSON files are stored
DATA_DIR=./data

# ---- Rate limit for POST /api/jobs (per IP) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
