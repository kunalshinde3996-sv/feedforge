# ---- LLM ----
# Which provider to use: anthropic | openai | gemini
LLM_PROVIDER=gemini
# Exact model id (required, no default on purpose), e.g. gemini-3.5-flash
LLM_MODEL=
# Optional: tried once per call when the primary model returns 429 (quota) or 503 (overloaded)
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Only the key for the chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Server ----
PORT=8080
# Where job JSON files are stored
DATA_DIR=./data

# ---- Rate limit for POST /api/jobs (per IP) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
